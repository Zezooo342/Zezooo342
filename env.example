# ملف المتغيرات البيئية - نسخة مثال
# ========================================
# انسخ هذا الملف إلى .env وأضف قيمك الحقيقية

# Perplexity Pro API Key (اختياري لكن موصى به بشدة)
# احصل عليه من: https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# إعدادات المحتوى (اختيارية)
NICHE=تطوير الذات وريادة الأعمال
LANGUAGE=ar
CONTENT_FOCUS=educational

# إعدادات المنصات (لحسابات المستقبل)
FACEBOOK_PAGE_ID=your_facebook_page_id
INSTAGRAM_USERNAME=your_instagram_username  
TIKTOK_USERNAME=your_tiktok_username
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# إعدادات متقدمة
DEBUG=false
POSTS_PER_WEEK=7
MAX_RETRIES=3
