# النظام الذكي لإنشاء الصفحات - متغيرات البيئة
# انسخ هذا الملف إلى .env وأضف القيم الحقيقية

# Perplexity AI API
PERPLEXITY_API_KEY=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

# إعدادات النظام
MAX_PAGES_PER_RUN=5
USE_PERPLEXITY=true
DEFAULT_LANGUAGE=ar

# مواضيع افتراضية (مفصولة بفواصل)
DEFAULT_TOPICS=الذكاء الاصطناعي,البرمجة الحديثة,التسويق الرقمي,ريادة الأعمال

# إعدادات متقدمة
ENABLE_ANALYTICS=true
ENABLE_SEO_OPTIMIZATION=true
GENERATE_SITEMAP=true

# CSS Theme (default, dark, modern, professional)
CSS_THEME=default

# تفعيل الميزات التجريبية
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_AI_IMAGE_GENERATION=false
